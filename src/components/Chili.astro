---
// The chili mark. Bezier paths lifted from WindowAccessor.swift so the site
// and the app's own window draw the same shape.
const { width = 11.7, id = "wm" } = Astro.props;
---
<svg width={width} height={width * 26 / 11.7} viewBox="38 4 38 110" fill="none"
     preserveAspectRatio="xMidYMid meet" style="display: block;" aria-hidden="true">
  <defs>
    <linearGradient id={id} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#FF8A1E"/>
      <stop offset="0.5" stop-color="#F5194E"/>
      <stop offset="1" stop-color="#B01277"/>
    </linearGradient>
  </defs>
  <path d="M53 25C50 16 46 11 41 8C45 7 50 9 54 14C57 18 58 21 57 25Z" fill="#FF8A1E"/>
  <path d="M53 22C64 22 72 32 72 48C72 67 64 86 54 98C50 103 45 108 42 110C44 105 47 100 49 93C51 78 54 62 54 51C54 40 43 32 53 22Z" fill={`url(#${id})`}/>
</svg>
