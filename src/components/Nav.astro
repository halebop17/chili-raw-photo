---
import Chili from "./Chili.astro";
const path = Astro.url.pathname;
const here = (p) => (path === p || (p !== "/" && path.startsWith(p)) ? "page" : undefined);
---
<nav class="nav">
  <div class="nav-in">
    <a class="brand" href="/">
      <Chili id="nav-wm" />
      <span class="brand-word"><span>chili</span><span class="brand-dot"></span><span>raw</span></span>
    </a>
    <div class="nav-links">
      <a class="nav-link" href="/features/" aria-current={here("/features/")}>Features</a>
      <a class="nav-link" href="/manual/" aria-current={here("/manual/")}>Manual</a>
      <a class="nav-link" href="/changelog/" aria-current={here("/changelog/")}>Changelog</a>
      <a class="nav-link" href="/pro/" aria-current={here("/pro/")}>Pro</a>
      <a class="btn btn-primary nav-download" style="margin-left: 22px; height: 44px;"
         href="/download/">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true" style="display: block;">
          <path d="M8 2.5 V10.5 M4.4 7 L8 10.6 L11.6 7 M3 13.2 H13" stroke="#FFFFFF"
                stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Download
      </a>
      <details class="nav-menu">
        <summary aria-label="Menu">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M3 5.5 H17 M3 10 H17 M3 14.5 H17" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
        </summary>
        <div class="nav-menu-panel">
          <a href="/features/" aria-current={here("/features/")}>Features</a>
          <a href="/manual/" aria-current={here("/manual/")}>Manual</a>
          <a href="/changelog/" aria-current={here("/changelog/")}>Changelog</a>
          <a href="/pro/" aria-current={here("/pro/")}>Pro</a>
          <a href="/articles/" aria-current={here("/articles/")}>Articles</a>
          <a href="/contact/" aria-current={here("/contact/")}>Contact</a>
        </div>
      </details>
    </div>
  </div>
</nav>

<script>
  // A menu left open closes when you tap anywhere else.
  const menu = document.querySelector<HTMLDetailsElement>(".nav-menu");
  document.addEventListener("click", (e) => {
    if (menu?.open && !menu.contains(e.target as Node)) menu.open = false;
  });
</script>
