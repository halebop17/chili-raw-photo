---
import Site from "../../layouts/Site.astro";
const articles = [
  { slug: "compressed-dng", kicker: "COMPRESSED DNG",
    title: "Chili RAW fully supports compressed DNG files, including the ones from DxO",
    blurb: "Compressed DNG files have been awkward for years. What JPEG XL does, why some software decodes them wrong, and how these files open properly here." },
  { slug: "why-a-new-raw-developer", kicker: "INTRODUCING",
    title: "Why we built a new type of RAW developer toolbox for photographers",
    blurb: "A folder of twelve hundred frames, an afternoon gone before anyone reached the good ones, and a monthly fee for the privilege." },
];
---
<Site title="Articles" description="Writing about Chili RAW — why it exists, and how parts of it work.">
  <div class="wrap" style="padding-top: clamp(40px, 5vw, 64px);">
    <div class="eyebrow">articles</div>
    <h1 class="h-hero" style="margin-top: 16px;">Articles</h1>
    <div class="h-sub" style="font-weight: 500; color: var(--dim); margin-top: 14px; max-width: 30ch;">
      Why it exists, and how parts of it work.
    </div>
  </div>
  <div class="wrap section" style="padding-bottom: 70px;">
    <div class="rule"></div>
    {articles.map((a) => (
      <a href={`/articles/${a.slug}/`} style="display: block; padding: 30px 0; border-bottom: 1px solid var(--border-soft); color: inherit;">
        <div class="eyebrow">{a.kicker}</div>
        <h2 class="h-sub" style="margin-top: 10px; max-width: 30ch;">{a.title}</h2>
        <p class="lead" style="margin-top: 12px; max-width: 66ch;">{a.blurb}</p>
        <span class="more" style="display: inline-block; margin-top: 14px;">Read →</span>
      </a>
    ))}
  </div>
</Site>
