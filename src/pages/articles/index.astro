---
import Site from "../../layouts/Site.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { articles, longDate } from "../../data/articles";
import { size } from "../../lib/images";
const [lead, ...rest] = articles;
const dim = await size(lead.image);
---
<Site title="Articles" pageType="CollectionPage" description="Guides, how-tos and stories about RAW photo editing on the Mac: culling, film emulation, highlights, sidecars, geotagging, and how Chili RAW works.">
  <div class="wrap ai-head">
    <h1 class="ai-h1">Articles</h1>
    <p class="ai-sub">{articles.length} guides, how-tos and stories, newest first.</p>
  </div>

  <div class="wrap">
    <div class="rule"></div>
    <a href={`/articles/${lead.slug}/`} class="ai-lead">
      <div class="ai-lead-pic">
        <img src={lead.image} alt={lead.imageAlt} width={dim?.width} height={dim?.height} fetchpriority="high" />
      </div>
      <div class="ai-lead-text">
        <div class="eyebrow ai-kick">{lead.kicker}</div>
        <h2 class="ai-lead-title">{lead.title}</h2>
        <p class="ai-lead-blurb">{lead.blurb}</p>
        <div class="eyebrow ai-date">{longDate(lead.date)}</div>
      </div>
    </a>

    <div class="ai-grid">
      {rest.map((a) => <ArticleCard a={a} />)}
    </div>
  </div>
</Site>

<style>
  .ai-head { padding-top: clamp(48px, 7vw, 96px); padding-bottom: clamp(30px, 4vw, 48px); }
  .ai-h1 { font-size: clamp(56px, 10vw, 132px); line-height: 0.95; letter-spacing: -0.045em; font-weight: 600; }
  .ai-sub { margin-top: clamp(18px, 2.4vw, 30px); font-size: clamp(16px, 1.5vw, 20px); color: var(--dim); }

  .ai-lead { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr); gap: clamp(28px, 4vw, 56px);
             align-items: center; margin-top: clamp(36px, 5vw, 56px); padding: clamp(14px, 1.6vw, 22px);
             padding-right: clamp(22px, 3.4vw, 48px); border-radius: 22px; color: inherit;
             background: var(--surface); border: 1px solid var(--border-soft); }
  .ai-lead:hover { color: inherit; border-color: var(--border); }
  .ai-lead-pic { aspect-ratio: 16 / 10; border-radius: 14px; overflow: hidden; background: var(--backdrop); }
  .ai-lead-pic img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top center; }
  .ai-kick { color: var(--accent); }
  .ai-lead-title { margin-top: 14px; font-size: clamp(28px, 3.4vw, 48px); line-height: 1.06; letter-spacing: -0.03em; }
  .ai-lead:hover .ai-lead-title { color: var(--accent); }
  .ai-lead-blurb { margin-top: 18px; font-size: clamp(15px, 1.25vw, 17.5px); line-height: 1.6; color: var(--dim); text-wrap: pretty; }
  .ai-date { margin-top: 22px; }

  .ai-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr));
             gap: clamp(40px, 4vw, 56px) clamp(22px, 2.4vw, 34px);
             padding-top: clamp(48px, 6vw, 76px); padding-bottom: clamp(70px, 9vw, 120px); }

  @media (max-width: 1000px) { .ai-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 820px) {
    .ai-lead { grid-template-columns: minmax(0, 1fr); padding-right: clamp(14px, 1.6vw, 22px); padding-bottom: 28px; }
    .ai-lead-text { padding-inline: 8px; }
  }
  @media (max-width: 620px) { .ai-grid { grid-template-columns: minmax(0, 1fr); } }
</style>
