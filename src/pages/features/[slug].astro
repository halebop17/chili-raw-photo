---
import Site from "../../layouts/Site.astro";
import features from "../../data/features.json";
import bodies from "../../data/feature-pages.json";

export function getStaticPaths() {
  return features.map((f) => ({ params: { slug: f.slug }, props: { f } }));
}
const { f } = Astro.props;
const body = bodies[f.key];
const others = features.filter((x) => x.slug !== f.slug);
const next = [others[(features.indexOf(f) + 1) % others.length],
              others[(features.indexOf(f) + 2) % others.length],
              others[(features.indexOf(f) + 3) % others.length]];
---
<Site title={f.title} description={f.sub || f.lead.slice(0, 155)}>
  <div class="feat" set:html={body} />

  <div class="wrap section-lg">
    <div class="grid grid-2">
      <div class="card">
        <div class="eyebrow">in the manual</div>
        <h3>Every control, written down</h3>
        <p>The manual covers this in full — what each control does, and what it does not.</p>
        <a class="more" href={`/manual/${f.chapter}/`}>Read the chapter →</a>
      </div>
      <div class="card">
        <div class="eyebrow" style={f.tier === "pro" ? "color: var(--violet);" : undefined}>
          {f.tier === "pro" ? "part of pro" : "in the free version"}
        </div>
        <h3>{f.tier === "pro" ? `${f.title} is part of Chili RAW Pro.` : `${f.title} is free, with no time limit.`}</h3>
        <p>{f.tier === "pro"
          ? "$29 until version 1.5, then $59 · one payment, no subscription, and every 1.x update — usually around 18 months of them · 7-day trial."
          : "No account, no watermark, and no time limit."}</p>
        <div class="btn-row" style="margin-top: 12px;">
          <a class="btn btn-primary" style="height: 44px;"
             href={f.tier === "pro" ? "/pro/" : "https://github.com/halebop17/chili-raw-photo/releases/latest"}>
            {f.tier === "pro" ? "What Pro adds" : "Download Chili RAW Free"}
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="wrap section" style="padding-bottom: 60px;">
    <div class="rule"></div>
    <div style="display: flex; flex-wrap: wrap; gap: 28px; margin-top: 22px; align-items: baseline;">
      <span class="eyebrow">next</span>
      {next.map((o) => <a href={`/features/${o.slug}/`} style="font-size: 14px;">{o.title} →</a>)}
    </div>
  </div>
</Site>
