---
import Site from "../../layouts/Site.astro";
import features from "../../data/features.json";
// one glyph per feature, named for its slug — see src/icons/README.md
const glyphs = import.meta.glob("../../icons/*.svg", { query: "?raw", import: "default", eager: true });
const glyph = (slug) => glyphs[`../../icons/${slug}.svg`] ?? "";
const free = features.filter((f) => f.tier === "free");
const pro = features.filter((f) => f.tier === "pro");
// Cells the Pro grid's last row would leave empty at three columns — filled by
// one card to the Pro page rather than left as a hole beside the last feature.
const proRest = (3 - (pro.length % 3)) % 3;
// The same for the free grid, with one card to the download.
const freeRest = (3 - (free.length % 3)) % 3;
---
<Site title="Features"
      description="Everything Chili RAW does: three RAW decoders, culling, masking, repair, the catalog, Film Labor, Pixels and the on-device AI tools.">
  <div class="wrap" style="padding-top: clamp(40px, 5vw, 64px);">
    <div class="eyebrow">every room in the app</div>
    <h1 class="h-hero" style="margin-top: 16px;">Features</h1>
    <div class="h-sub" style="font-weight: 500; color: var(--dim); margin-top: 14px; max-width: 30ch;">
      One window, from the card to the finished file.
    </div>
    <p class="lead" style="margin-top: 20px; max-width: 68ch;">
      Most of this is in the free version, in full. The handful that is not is marked.
    </p>
  </div>

  <div class="wrap section">
    <div class="eyebrow">in the free version</div>
    <div class="grid grid-3" style="margin-top: 22px;">
      {free.map((f) => (
        <a class="card has-mark" href={`/features/${f.slug}/`} style="color: inherit;">
          <span class="mark" set:html={glyph(f.slug)} />
          <h3>{f.title}</h3>
          <p>{f.sub}</p>
          <span class="more">More info →</span>
        </a>
      ))}
      {freeRest > 0 && (
        <a class="card free-rest" href="https://github.com/halebop17/chili-raw-photo/releases/latest" style={`color: inherit; --span: ${freeRest};`}>
          <div class="eyebrow">no time limit</div>
          <h3>Everything above is free</h3>
          <p>No account, no watermark, and no time limit. Download Chili RAW and all of it is yours to use.</p>
          <span class="more">Download Chili RAW Free →</span>
        </a>
      )}
    </div>
  </div>

  <div class="wrap section-lg" style="padding-bottom: 60px;">
    <div class="eyebrow" style="color: var(--violet);">part of pro</div>
    <div class="grid grid-3" style="margin-top: 22px;">
      {pro.map((f) => (
        <a class="card has-mark" href={`/features/${f.slug}/`} style="color: inherit;">
          <span class="mark" set:html={glyph(f.slug)} />
          <h3>{f.title}</h3>
          <p>{f.sub}</p>
          <span class="more">More info →</span>
        </a>
      ))}
      {proRest > 0 && (
        <a class="card pro-rest" href="/pro/" style={`color: inherit; --span: ${proRest};`}>
          <div class="eyebrow" style="color: var(--violet);">one licence</div>
          <h3>Everything in Pro</h3>
          <p>All of the above in one licence — $29 founding price, version 1 + 2 included, with a 7-day trial first.</p>
          <span class="more">What Pro adds →</span>
        </a>
      )}
    </div>
  </div>
</Site>
