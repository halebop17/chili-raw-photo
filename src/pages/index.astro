---
import Site from "../layouts/Site.astro";
import bodies from "../data/feature-pages.json";
import { sizeImages } from "../lib/images";
import { articles } from "../data/articles";

// The homepage is the design's own markup, ported by tools/design-to-site.py.
// Hand-writing it meant six sections were quietly left out of it.
//
// Its "latest" strip is the exception: the design draws three articles by
// hand, so they are replaced here by the three newest in src/data/articles.ts.
// If the design ever loses the strip, the build fails rather than going stale.
const latest = /(>latest<\/span>[\s\S]*?<div class="pg-3"[^>]*>)[\s\S]*?(<\/div>)/;
if (!latest.test(bodies.Home)) throw new Error("index.astro: the homepage's latest-articles strip was not found");
const esc = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;");
const stamp = (iso: string) =>
  new Date(iso + "T12:00:00Z").toLocaleDateString("en-GB", { month: "short", year: "2-digit", timeZone: "UTC" }).toUpperCase();
const cards = articles.slice(0, 3).map((a) =>
  `<a href="/articles/${a.slug}/" style="display: flex; flex-direction: column; gap: 10px; padding: 0 34px 0 0; color: inherit;">` +
  `<span style="font-family: var(--mono); font-size: 10px; letter-spacing: 0.12em; color: var(--faint);">${esc(a.kicker.toUpperCase())} · ${stamp(a.date)}</span>` +
  `<span style="font-size: 17px; line-height: 1.32; font-weight: 500; letter-spacing: -0.012em; color: var(--text);">${esc(a.title)}</span>` +
  `<span style="font-family: var(--mono); font-size: 11.5px; color: var(--accent);">Read →</span></a>`).join("\n      ");
const body = await sizeImages(bodies.Home.replace(latest, (_, open, close) => `${open}\n      ${cards}\n    ${close}`));
const title = "Chili RAW — RAW photo editor and culler for the Mac";
const description = "Chili RAW is a photo developer, culler and asset manager for the Mac. Three RAW decoders, AI masking, film looks and a darkroom — no cloud, no account.";
---
<Site title={title} name="Chili RAW" description={description} aboutApp>
  <div class="feat" set:html={body} />
</Site>
