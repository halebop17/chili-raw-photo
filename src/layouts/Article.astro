---
// An article: its header from src/data/articles.ts, a wide picture if it has
// one, the reading column, and three more articles under it. The page itself
// writes only the description and the body, in plain p / h2 / ul tags.
import Site from "./Site.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { articles, bySlug, longDate } from "../data/articles";
import { size } from "../lib/images";
interface Props { slug: string; description: string; hero?: string; heroAlt?: string; caption?: string }
const { slug, description, hero, heroAlt = "", caption } = Astro.props;
const a = bySlug(slug);
const dim = hero ? await size(hero) : null;
// Same category first, then the newest of the rest.
const others = articles.filter((x) => x.slug !== slug);
const more = [...others.filter((x) => x.kicker === a.kicker), ...others.filter((x) => x.kicker !== a.kicker)].slice(0, 3);
---
<Site type="article" title={a.title} description={description} published={a.date}
      image={`/og/${slug}.jpg`} imageAlt={a.imageAlt}>
  <div class="wrap" style="padding-top: clamp(30px, 4vw, 48px);">
    <a href="/articles/" class="eyebrow" style="color: var(--mute);">&#8592; Articles</a>
  </div>

  <header class="art-head">
    <div class="eyebrow" style="color: var(--accent);">{a.kicker}</div>
    <h1 class="art-title">{a.title}</h1>
    <div class="eyebrow" style="margin-top: 22px;">{longDate(a.date)}</div>
  </header>

  {hero && (
    <figure class="wrap art-hero">
      <img src={hero} alt={heroAlt} width={dim?.width} height={dim?.height} fetchpriority="high" />
      {caption && <figcaption class="art-cap">{caption}</figcaption>}
    </figure>
  )}

  <article class="art"><slot /></article>

  <section class="wrap art-more">
    <div class="rule"></div>
    <h2 class="h-sec" style="margin-top: clamp(40px, 5vw, 64px);">More articles</h2>
    <div class="art-more-grid">
      {more.map((m) => <ArticleCard a={m} level="h3" />)}
    </div>
  </section>
</Site>

<style>
  .art-head { width: min(720px, 100% - 2 * var(--gutter)); margin-inline: auto; padding-top: clamp(26px, 4vw, 44px); }
  .art-title { margin-top: 16px; font-size: clamp(32px, 4.6vw, 58px); line-height: 1.04; letter-spacing: -0.03em; }
  .art-hero { margin: clamp(34px, 4.5vw, 52px) auto 0; }
  .art-hero img { display: block; width: 100%; height: auto; border-radius: 14px; border: 1px solid var(--border-soft); }
  .art-more { padding-bottom: clamp(70px, 9vw, 120px); }
  .art-more-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 34px;
                   margin-top: clamp(26px, 3vw, 40px); }
  @media (max-width: 1000px) { .art-more-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
                               .art-more-grid > :nth-child(3) { display: none; } }
  @media (max-width: 620px)  { .art-more-grid { grid-template-columns: minmax(0, 1fr); }
                               .art-more-grid > :nth-child(3) { display: flex; } }
</style>

<style is:global>
  /* The reading column. Global, because the body is the page's markup, not this file's. */
  .art { width: min(720px, 100% - 2 * var(--gutter)); margin-inline: auto;
         padding-top: clamp(38px, 5vw, 58px); padding-bottom: clamp(64px, 8vw, 100px);
         display: flex; flex-direction: column; gap: 22px; }
  .art > p, .art > ul, .art > ol { font-size: clamp(16px, 1.3vw, 18px); line-height: 1.7; color: var(--dim); text-wrap: pretty; }
  .art > ul, .art > ol { margin: 0; padding-left: 1.15em; display: flex; flex-direction: column; gap: 10px; }
  .art strong { color: var(--text); font-weight: 600; }
  .art > h2 { font-size: clamp(22px, 2.2vw, 30px); line-height: 1.15; max-width: 26ch; margin-top: clamp(22px, 3vw, 34px); }
  .art > figure { margin: 10px 0; }
  .art > figure img { display: block; width: 100%; height: auto; border-radius: 10px; border: 1px solid var(--border-soft); }
  .art-cap { font-family: var(--mono); font-size: 12px; color: var(--faint); margin-top: 12px; line-height: 1.6; }
  .art .art-cta { color: var(--text); }
</style>
